<!-- Goban UI — flat grid, one pressable cell per intersection. -->
<column background="background" grow="1" gap="0">
  <row height="48" padding="12" gap="8" cross="center" background="surface" window-drag="true" label="header">
    <text size="heading">Goban</text>
    <spacer grow="1" />
    <button size="sm" variant="secondary" on-press="undo" disabled="{cannotUndo}">Undo</button>
    <button size="sm" variant="primary" on-press="reset">New</button>
  </row>
  <separator />

  <row padding="10" gap="8" cross="center" background="surface_subtle">
    <button size="sm" selected="{vsHuman}" on-press="set_mode_pvp">2P</button>
    <button size="sm" selected="{vsAi}" on-press="set_mode_ai">AI</button>
    <spacer grow="1" />
    <if test="{blackWins}">
      <badge>Black wins</badge>
    </if>
    <else>
      <if test="{whiteWins}">
        <badge>White wins</badge>
      </if>
      <else>
        <if test="{isDraw}">
          <badge>Draw</badge>
        </if>
        <else>
          <if test="{isBlackTurn}">
            <badge>Black to move</badge>
          </if>
          <else>
            <badge>White to move</badge>
          </else>
        </else>
      </else>
    </else>
  </row>
  <separator />

  <column grow="1" padding="12" gap="10" main="start" cross="center">
    <text foreground="text_muted">Tap a square to place · B=black · W=white</text>

    <column background="surface" radius="md" padding="8" border-color="border">
      <grid columns="15" gap="2">
        <for each="cells" key="index" as="c">
          <if test="{c.isBlack}">
            <button
              width="34"
              height="34"
              variant="primary"
              selected="{c.highlight}"
              on-press="place:{c.index}"
            >B</button>
          </if>
          <else>
            <if test="{c.isWhite}">
              <button
                width="34"
                height="34"
                variant="secondary"
                selected="{c.highlight}"
                on-press="place:{c.index}"
              >W</button>
            </if>
            <else>
              <button
                width="34"
                height="34"
                variant="outline"
                on-press="place:{c.index}"
              >+</button>
            </else>
          </else>
        </for>
      </grid>
    </column>

    <text foreground="text_muted">moves {moveCount} · Cmd+Z undo · Cmd+N new</text>
  </column>

  <status-bar>Game menu · Cmd+1 2P · Cmd+2 AI</status-bar>
</column>
