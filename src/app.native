<!-- Five-in-a-row board UI: wood panel, round stones, star points, sidebar. -->
<column background="background" grow="1" gap="0">
  <!-- Title bar -->
  <row height="52" padding="12" gap="10" cross="center" background="surface" window-drag="true" label="header">
    <column gap="0">
      <text size="heading">Five in a Row</text>
      <text foreground="text_muted">15 x 15 goban · black first</text>
    </column>
    <spacer grow="1" />
    <button size="sm" variant="secondary" on-press="undo" disabled="{cannotUndo}">Undo</button>
    <button size="sm" variant="primary" on-press="reset">New game</button>
  </row>
  <separator />

  <row grow="1" gap="0">
    <!-- Board column -->
    <column grow="1" padding="16" gap="12" main="center" cross="center" background="background">
      <!-- Warm "wood" panel (warning token ≈ amber) -->
      <column background="warning" radius="lg" padding="14" gap="0" label="board">
        <grid columns="15" gap="1">
          <for each="cells" key="index" as="c">
            <!-- Black stone: solid dark circle -->
            <if test="{c.isBlack}">
              <button
                width="32"
                height="32"
                radius="xl"
                variant="primary"
                selected="{c.highlight}"
                on-press="place:{c.index}"
                label="black stone"
              ></button>
            </if>
            <else>
              <!-- White stone: light circle -->
              <if test="{c.isWhite}">
                <button
                  width="32"
                  height="32"
                  radius="xl"
                  variant="secondary"
                  selected="{c.highlight}"
                  on-press="place:{c.index}"
                  label="white stone"
                ></button>
              </if>
              <else>
                <!-- Empty star point -->
                <if test="{c.isStar}">
                  <button
                    width="32"
                    height="32"
                    radius="xl"
                    variant="ghost"
                    on-press="place:{c.index}"
                    label="star point"
                  >o</button>
                </if>
                <else>
                  <!-- Empty intersection -->
                  <button
                    width="32"
                    height="32"
                    radius="xl"
                    variant="ghost"
                    on-press="place:{c.index}"
                    label="empty"
                  >.</button>
                </else>
              </else>
            </else>
          </for>
        </grid>
      </column>

      <text foreground="text_muted">Click an intersection to place a stone</text>
    </column>

    <separator />

    <!-- Sidebar: players / mode / status -->
    <column width="200" padding="14" gap="12" background="surface">
      <text>Players</text>

      <column gap="6" padding="10" background="surface_subtle" radius="md">
        <row gap="8" cross="center">
          <button width="22" height="22" radius="xl" variant="primary" label="black" disabled="true"></button>
          <text>Black</text>
          <spacer grow="1" />
          <if test="{isBlackTurn}">
            <badge>turn</badge>
          </if>
        </row>
        <if test="{vsAi}">
          <text foreground="text_muted">you</text>
        </if>
        <else>
          <text foreground="text_muted">player 1</text>
        </else>
      </column>

      <column gap="6" padding="10" background="surface_subtle" radius="md">
        <row gap="8" cross="center">
          <button width="22" height="22" radius="xl" variant="secondary" label="white" disabled="true"></button>
          <text>White</text>
          <spacer grow="1" />
          <if test="{isWhiteTurn}">
            <badge>turn</badge>
          </if>
        </row>
        <if test="{vsAi}">
          <text foreground="text_muted">computer</text>
        </if>
        <else>
          <text foreground="text_muted">player 2</text>
        </else>
      </column>

      <separator />

      <text>Mode</text>
      <column gap="6">
        <button selected="{vsHuman}" on-press="set_mode_pvp">2 players</button>
        <button selected="{vsAi}" on-press="set_mode_ai">vs computer</button>
      </column>

      <separator />

      <text>Status</text>
      <if test="{blackWins}">
        <badge>Black wins</badge>
      </if>
      <else>
        <if test="{whiteWins}">
          <badge>White wins</badge>
        </if>
        <else>
          <if test="{isDraw}">
            <badge>Draw</badge>
          </if>
          <else>
            <if test="{isBlackTurn}">
              <text>Black to move</text>
            </if>
            <else>
              <text>White to move</text>
            </else>
          </else>
        </else>
      </else>
      <text foreground="text_muted">moves {moveCount}</text>

      <spacer grow="1" />

      <column gap="4">
        <text foreground="text_muted">Cmd+Z undo</text>
        <text foreground="text_muted">Cmd+N new game</text>
        <text foreground="text_muted">five in a row wins</text>
      </column>
    </column>
  </row>
</column>
